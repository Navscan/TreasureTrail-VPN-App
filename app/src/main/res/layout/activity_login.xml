<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0f18"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPvpn"
        android:textColor="#f5c842"
        android:textSize="32sp"
        android:textStyle="bold|italic"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENTERPRISE ACCESS"
        android:textColor="#8a9bb0"
        android:textSize="12sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#0f1724"
        android:hint="Corporate Email"
        android:inputType="textEmailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#e8edf5"
        android:textColorHint="#8a9bb0"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#0f1724"
        android:hint="Password"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#e8edf5"
        android:textColorHint="#8a9bb0"
        android:layout_marginBottom="24dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="#f5c842"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#ff6b6b"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#f5c842"
        android:text="SIGN IN"
        android:textColor="#000000"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnToggleMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:text="Need an account? Register"
        android:textColor="#4cd9b2"
        android:textSize="14sp" />

</LinearLayout>
