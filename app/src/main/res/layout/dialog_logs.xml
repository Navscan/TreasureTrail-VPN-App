<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="@string/dialog_logs_title"
            android:textAllCaps="true"
            android:textColor="@color/muted_label"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtLogStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/log_status_on"
            android:textColor="@color/muted_label"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnLogsClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/dialog_logs_clear"
            android:textColor="@color/brand_gold"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnLogsClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/dialog_logs_close"
            android:textColor="@color/brand_gold"
            android:textSize="10sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/code_bg"
        android:minHeight="320dp"
        android:maxHeight="480dp"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/logsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <CheckBox
        android:id="@+id/checkKeepLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:buttonTint="@color/brand_gold"
        android:text="@string/dialog_logs_keep"
        android:textColor="@color/text_main"
        android:textSize="11sp" />
</LinearLayout>
